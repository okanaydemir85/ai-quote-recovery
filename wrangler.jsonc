
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-quote-recovery",
  "main": "src/index.js",
  "compatibility_date": "2026-11-26",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quote-recovery-db",
      "database_id": "e8ee9088-7f17-4fb8-8190-22b173c34eaf"
    }
  ]
}
